# ==========================================
# LastWave Desktop Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env with real secrets.
# Variable names mirror LastWave-native (.env.example)
# ==========================================

# Addon one-way lock (HMAC request proofs). Must match the addon
# server's ADDON_CLIENT_SECRET, otherwise every addon call 404s.
ADDON_CLIENT_SECRET=

# Google Drive sync (Settings > General > Backup & Restore). OAuth client of
# type "Desktop app" in the same Google Cloud project as the phone app's
# Android client, with the Drive API enabled. Empty = Drive sync hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
